# --- Flask -----------------------------------------------------------------
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-string

# --- Database ----------------------------------------------------------------
# Defaults to a local SQLite file if unset.
DATABASE_URL=sqlite:///aether.db

# --- AI Provider ---------------------------------------------------------------
# "mock" works fully offline. Set to "openai" / "anthropic" / "gemini" / "grok"
# once the matching provider class is implemented in services/ai.py.
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=aether-mock-v1

# --- Server --------------------------------------------------------------------
PORT=5000
